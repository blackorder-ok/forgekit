{
  "permissions": {
    "deny": ["Read(./secrets/*-secrets.properties)", "Read(./.env)", "Read(./.env.*)", "Read(~/.ssh/**)", "Read(~/.aws/**)", "Read(~/.config/gh/**)", "Bash(git push --force*)", "Bash(git push -f*)"]
  },
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT:-$HOME/.kit/repo/plugins/forge}/scripts/hook_launch.sh\" --selfcheck"}]}
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT:-$HOME/.kit/repo/plugins/forge}/scripts/hook_launch.sh\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/branch_guard.sh\""},
          {"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT:-$HOME/.kit/repo/plugins/forge}/scripts/hook_launch.sh\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/test_guard.py\""}
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT:-$HOME/.kit/repo/plugins/forge}/scripts/hook_launch.sh\" \"${CLAUDE_PLUGIN_ROOT:-$HOME/.kit/repo/plugins/forge}/scripts/bash_gate.py\""}
        ]
      }
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT:-$HOME/.kit/repo/plugins/forge}/scripts/hook_launch.sh\" \"${CLAUDE_PLUGIN_ROOT:-$HOME/.kit/repo/plugins/forge}/scripts/fix_prompt.py\""}]}
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT:-$HOME/.kit/repo/plugins/forge}/scripts/hook_launch.sh\" \"${CLAUDE_PLUGIN_ROOT:-$HOME/.kit/repo/plugins/forge}/scripts/fix_warn.py\""}
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT:-$HOME/.kit/repo/plugins/forge}/scripts/hook_launch.sh\" \"${CLAUDE_PLUGIN_ROOT:-$HOME/.kit/repo/plugins/forge}/scripts/secret_post.py\""}]
      }
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT:-$HOME/.kit/repo/plugins/forge}/scripts/hook_launch.sh\" \"${CLAUDE_PLUGIN_ROOT:-$HOME/.kit/repo/plugins/forge}/scripts/secret_stop.py\""}]},
      {"hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT:-$HOME/.kit/repo/plugins/forge}/scripts/hook_launch.sh\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/diff_budget.sh\""}]}
    ]
  }
}
