{
  "version": 1,
  "protectedBranches": [
    "master",
    "qa",
    "release"
  ],
  "protectedPaths": [
    "tests/*",
    ".githooks/*"
  ],
  "bash": {
    "deny": [
      "\\bgit\\s+push\\b.*\\s(master|qa|release)\\b",
      "\\bgit\\s+push\\b.*--mirror",
      "\\bgit\\s+push\\b.*(--delete|\\s-d\\b)",
      "\\bgit\\s+push\\b.*(--force|\\s-f\\b)",
      "\\bgit\\s+tag\\s+(-d|-f)\\b",
      "\\s--no-verify\\b",
      "\\bsudo\\b",
      "\\b(curl|wget)\\b[^|;&\\n]*\\|\\s*(sudo\\s+)?(ba|z|da)?sh\\b"
    ],
    "ask": [
      "\\bgit\\s+push\\b",
      "\\bgh\\s+pr\\s+merge\\b",
      "\\bgh\\s+secret\\s+set\\b",
      "\\bgh\\s+api\\b.*(-X|--method)\\s*(DELETE|PUT|PATCH)\\b",
      "\\bdocker\\s+compose\\s+down\\b.*(\\s-v\\b|--volumes)",
      "\\bgit\\s+reset\\s+--hard\\b"
    ]
  },
  "secretPaths": [
    ".env",
    ".env.*",
    "secrets/*",
    "*/secrets/*",
    "*-secrets.properties",
    ".ssh/*",
    "*/.ssh/*",
    ".aws/*",
    "*/.aws/*",
    ".config/gh/*",
    "*/.config/gh/*"
  ],
  "agents": {
    "product-owner": {
      "privilege": "read",
      "bashAllow": []
    },
    "architect": {
      "privilege": "edit",
      "writeAllow": [
        "docs/design/**",
        "docs/plan.md",
        "**/*.plan.md"
      ],
      "bashAllow": []
    },
    "reviewer": {
      "privilege": "read",
      "bashAllow": [
        "git (diff|log|show|status|grep|ls-files|rev-parse|blame)\\b[^;&|<>$`()]*",
        "pip-audit -r [\\w./-]+",
        "bandit( -[\\w]+| [\\w./-]+)*",
        "gitleaks (detect|dir)( --[\\w-]+| [\\w./-]+)*",
        "semgrep( --[\\w-]+(=[\\w./,-]+)?| [\\w./-]+)*"
      ]
    },
    "security-reviewer": {
      "privilege": "read",
      "bashAllow": [
        "git (diff|log|show|status|grep|ls-files|rev-parse|blame)\\b[^;&|<>$`()]*",
        "pip-audit -r [\\w./-]+",
        "bandit( -[\\w]+| [\\w./-]+)*",
        "gitleaks (detect|dir)( --[\\w-]+| [\\w./-]+)*",
        "semgrep( --[\\w-]+(=[\\w./,-]+)?| [\\w./-]+)*"
      ]
    },
    "developer": {
      "privilege": "edit",
      "writeDeny": [
        "tests/**",
        ".github/**",
        "docker/**",
        ".claude/**",
        "plugins/**"
      ]
    },
    "tester": {
      "privilege": "edit",
      "writeAllow": [
        "tests/**",
        "docs/qa/**"
      ]
    },
    "ai-evaluator": {
      "privilege": "edit",
      "writeAllow": [
        "evals/cases.jsonl"
      ]
    },
    "doc-updater": {
      "privilege": "edit",
      "writeAllow": [
        "**/*.md",
        "CHANGELOG.md",
        "docs/**",
        "release-notes/**"
      ],
      "bashAllow": [
        "git (diff|log|show|status)\\b[^;&|<>$`()]*",
        "rg( -[\\w]+| [\\w./*-]+)*"
      ]
    },
    "ops": {
      "privilege": "edit",
      "writeAllow": [
        "docker/**",
        ".github/**"
      ]
    }
  }
}
