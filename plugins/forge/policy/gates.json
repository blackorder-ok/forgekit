{
  "version": 1,
  "protectedBranches": [
    "master",
    "qa",
    "release"
  ],
  "protectedPaths": [
    "tests/*",
    ".githooks/*"
  ],
  "bash": {
    "deny": [
      "\\bgit\\s+push\\b.*\\s(master|qa|release)\\b",
      "\\bgit\\s+push\\b.*--mirror",
      "\\bgit\\s+push\\b.*(--delete|\\s-d\\b)",
      "\\bgit\\s+push\\b.*(--force|\\s-f\\b)",
      "\\bgit\\s+tag\\s+(-d|-f)\\b",
      "\\s--no-verify\\b",
      "\\bsudo\\b",
      "\\b(curl|wget)\\b[^|;&\\n]*\\|\\s*(sudo\\s+)?(ba|z|da)?sh\\b"
    ],
    "ask": [
      "\\bgit\\s+push\\b",
      "\\bgh\\s+pr\\s+merge\\b",
      "\\bgh\\s+secret\\s+set\\b",
      "\\bgh\\s+api\\b.*(-X|--method)\\s*(DELETE|PUT|PATCH)\\b",
      "\\bdocker\\s+compose\\s+down\\b.*(\\s-v\\b|--volumes)",
      "\\bgit\\s+reset\\s+--hard\\b"
    ]
  },
  "secretPaths": [
    ".env",
    ".env.*",
    "secrets/*",
    "*/secrets/*",
    "*-secrets.properties",
    ".ssh/*",
    "*/.ssh/*",
    ".aws/*",
    "*/.aws/*",
    ".config/gh/*",
    "*/.config/gh/*"
  ],
  "agents": {
    "architect": {
      "privilege": "read"
    },
    "product-owner": {
      "privilege": "read"
    },
    "reviewer": {
      "privilege": "read"
    },
    "security-reviewer": {
      "privilege": "read"
    },
    "ai-evaluator": {
      "privilege": "read"
    },
    "developer": {
      "privilege": "edit"
    },
    "tester": {
      "privilege": "edit"
    },
    "doc-updater": {
      "privilege": "edit"
    },
    "ops": {
      "privilege": "full"
    }
  }
}
